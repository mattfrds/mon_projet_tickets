{% extends 'base.html.twig' %}

{% block title %}Mes Tickets{% endblock %}

{% block body %}
<div class="row mb-4">
    <div class="col">
        <h1><i class="bi bi-ticket-detailed"></i> Liste des tickets</h1>
        <p class="text-muted">Consultez et mettez à jour le statut des tickets</p>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Auteur</th>
                        <th>Description</th>
                        <th>Catégorie</th>
                        <th>Statut</th>
                        <th>Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for ticket in tickets %}
                    <tr>
                        <td>{{ ticket.id }}</td>
                        <td>{{ ticket.authorEmail }}</td>
                        <td>{{ ticket.description|length > 50 ? ticket.description|slice(0, 50) ~ '...' : ticket.description }}</td>
                        <td><span class="badge bg-secondary">{{ ticket.category.name }}</span></td>
                        <td>
                            {% set statusClass = 'secondary' %}
                            {% if ticket.status.name == 'Nouveau' %}
                                {% set statusClass = 'warning' %}
                            {% elseif ticket.status.name == 'Ouvert' %}
                                {% set statusClass = 'info' %}
                            {% elseif ticket.status.name == 'Résolu' %}
                                {% set statusClass = 'primary' %}
                            {% elseif ticket.status.name == 'Fermé' %}
                                {% set statusClass = 'success' %}
                            {% endif %}
                            <span class="badge bg-{{ statusClass }}">{{ ticket.status.name }}</span>
                        </td>
                        <td>{{ ticket.openedAt|date('d/m/Y H:i') }}</td>
                        <td>
                            <div class="btn-group btn-group-sm">
                                <a href="{{ path('staff_ticket_show', {id: ticket.id}) }}" class="btn btn-info">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a href="{{ path('staff_ticket_edit_status', {id: ticket.id}) }}" class="btn btn-warning">
                                    <i class="bi bi-pencil"></i> Statut
                                </a>
                            </div>
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="7" class="text-center text-muted">Aucun ticket</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}