{% extends 'base.html.twig' %}

{% block title %}Créer un ticket{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0"><i class="bi bi-ticket-perforated"></i> Créer un nouveau ticket</h4>
            </div>
            <div class="card-body">
                <p class="text-muted">Vous rencontrez un problème ? Décrivez-le ci-dessous et notre équipe vous contactera rapidement.</p>
                
                {{ form_start(form) }}
                    {{ form_row(form.authorEmail) }}
                    {{ form_row(form.category) }}
                    {{ form_row(form.description) }}
                    
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-lg">
                            <i class="bi bi-send"></i> Envoyer le ticket
                        </button>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>

        {% if not app.user %}
        <div class="text-center mt-4">
            <p class="text-muted">Vous êtes membre de l'agence ?</p>
            <a href="{{ path('app_login') }}" class="btn btn-outline-primary">
                <i class="bi bi-box-arrow-in-right"></i> Se connecter
            </a>
        </div>
        {% endif %}
    </div>
</div>
{% endblock %}