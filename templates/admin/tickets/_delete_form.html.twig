<form method="post" action="{{ path('admin_ticket_delete', {'id': ticket.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce ticket ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ ticket.id) }}">
    <button class="btn btn-danger">
        <i class="fas fa-trash"></i> Supprimer ce ticket
    </button>
</form>