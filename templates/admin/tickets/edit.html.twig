{% extends 'base.html.twig' %}

{% block title %}Modifier le Ticket #{{ ticket.id }}{% endblock %}

{% block body %}
    <div class="container mt-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1>Modifier le Ticket #{{ ticket.id }}</h1>
            <a href="{{ path('admin_tickets') }}" class="btn btn-outline-secondary">Retour à la liste</a>
        </div>

        <div class="card shadow-sm">
            <div class="card-body">
                {{ form_start(form) }}
                    {{ form_widget(form) }}
                    <div class="mt-3">
                        <button class="btn btn-primary">
                            <i class="fas fa-save"></i> Enregistrer les modifications
                        </button>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>

        <div class="mt-4 p-3 border-top">
            <p class="text-muted">Zone dangereuse</p>
            {{ include('admin/tickets/_delete_form.html.twig') }}
        </div>
    </div>
{% endblock %}