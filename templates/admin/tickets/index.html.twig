{% extends 'base.html.twig' %}

{% block title %}Gestion des Tickets{% endblock %}

{% block body %}
<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="bi bi-list-task"></i> Tous les Tickets</h1>
        <a href="{{ path('admin_ticket_new') }}" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Nouveau Ticket
        </a>
    </div>

    <div class="card shadow">
        <div class="card-body">
            <table class="table table-hover">
                <thead class="table-light">
                    <tr>
                        <th>Date</th>
                        <th>Client</th>
                        <th>Catégorie</th>
                        <th>Statut</th>
                        <th>Responsable</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for ticket in tickets %}
                    <tr>
                        <td>{{ ticket.openedAt|date('d/m/Y H:i') }}</td>
                        <td>{{ ticket.authorEmail }}</td>
                        <td><span class="badge bg-info">{{ ticket.category.name }}</span></td>
                        <td>
                            <span class="badge bg-{{ ticket.status.name == 'Nouveau' ? 'danger' : 'success' }}">
                                {{ ticket.status.name }}
                            </span>
                        </td>
                        <td>{{ ticket.responsible ? ticket.responsible.firstName : '<em>Non assigné</em>'|raw }}</td>
                        <td>
                            <a href="{{ path('admin_ticket_show', {id: ticket.id}) }}" class="btn btn-sm btn-outline-primary">Voir</a>
                            <a href="{{ path('admin_ticket_edit', {id: ticket.id}) }}" class="btn btn-sm btn-outline-secondary">Modifier</a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" class="text-center">Aucun ticket en base de données.</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}