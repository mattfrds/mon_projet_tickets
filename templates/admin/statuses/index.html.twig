{% extends 'base.html.twig' %}

{% block title %}Gestion des Statuts{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="bi bi-gear-wide-connected"></i> Liste des Statuts</h1>
        <a href="{{ path('admin_status_new') }}" class="btn btn-info text-white">
            <i class="bi bi-plus-circle"></i> Ajouter un statut
        </a>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}

    <div class="card shadow border-info">
        <div class="card-body">
            <table class="table table-hover">
                <thead class="table-info">
                    <tr>
                        <th>ID</th>
                        <th>Nom du statut</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for status in statuses %}
                    <tr>
                        <td>{{ status.id }}</td>
                        <td>
                            <span class="badge {{ status.name == 'Nouveau' ? 'bg-danger' : 'bg-primary' }}">
                                {{ status.name }}
                            </span>
                        </td>
                        <td>
                            <div class="btn-group">
                                <a href="{{ path('admin_status_edit', {id: status.id}) }}" class="btn btn-sm btn-outline-warning">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form method="post" action="{{ path('admin_status_delete', {id: status.id}) }}" onsubmit="return confirm('Supprimer ce statut ?');" style="display:inline-block">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ status.id) }}">
                                    <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="3" class="text-center">Aucun statut défini.</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <div class="mt-3">
        <a href="{{ path('admin_dashboard') }}" class="btn btn-secondary">Retour au Dashboard</a>
    </div>
</div>
{% endblock %}