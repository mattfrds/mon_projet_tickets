{% extends 'base.html.twig' %}

{% block title %}Dashboard Admin{% endblock %}

{% block body %}
<div class="row mb-4">
    <div class="col">
        <h1><i class="bi bi-speedometer2"></i> Dashboard Administrateur</h1>
        <p class="text-muted">Bienvenue dans l'interface d'administration</p>
    </div>
</div>

<div class="row">
    <div class="col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <h2 class="text-primary">{{ tickets|length }}</h2>
                <p class="text-muted mb-0">Tickets total</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <h2 class="text-warning">{{ tickets|filter(t => t.status.name == 'Nouveau')|length }}</h2>
                <p class="text-muted mb-0">Nouveaux tickets</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <h2 class="text-info">{{ tickets|filter(t => t.status.name == 'Ouvert')|length }}</h2>
                <p class="text-muted mb-0">En cours</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <h2 class="text-success">{{ tickets|filter(t => t.status.name == 'Fermé')|length }}</h2>
                <p class="text-muted mb-0">Fermés</p>
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-ticket"></i> Derniers tickets</h5>
                <a href="{{ path('admin_tickets') }}" class="btn btn-sm btn-primary">Voir tous les tickets</a>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Auteur</th>
                                <th>Catégorie</th>
                                <th>Statut</th>
                                <th>Date</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for ticket in tickets|slice(0, 10) %}
                            <tr>
                                <td>{{ ticket.id }}</td>
                                <td>{{ ticket.authorEmail }}</td>
                                <td><span class="badge bg-secondary">{{ ticket.category.name }}</span></td>
                                <td>
                                    {% set statusClass = 'secondary' %}
                                    {% if ticket.status.name == 'Nouveau' %}
                                        {% set statusClass = 'warning' %}
                                    {% elseif ticket.status.name == 'Ouvert' %}
                                        {% set statusClass = 'info' %}
                                    {% elseif ticket.status.name == 'Résolu' %}
                                        {% set statusClass = 'primary' %}
                                    {% elseif ticket.status.name == 'Fermé' %}
                                        {% set statusClass = 'success' %}
                                    {% endif %}
                                    <span class="badge bg-{{ statusClass }}">{{ ticket.status.name }}</span>
                                </td>
                                <td>{{ ticket.openedAt|date('d/m/Y H:i') }}</td>
                                <td>
                                    <a href="{{ path('admin_ticket_show', {id: ticket.id}) }}" class="btn btn-sm btn-info">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                </td>
                            </tr>
                            {% else %}
                            <tr>
                                <td colspan="6" class="text-center text-muted">Aucun ticket</td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}